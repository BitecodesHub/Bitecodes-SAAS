# Copy this file to .env.local and provide newly rotated credentials.
# Never paste production values into chat, source control, logs, or client code.

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=bitecodes

# SMTP (port 465 normally uses SMTP_SECURE=true; port 587 normally uses false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Bitecodes <no-reply@bitecodes.com>"

# Comma-separated recipients for new lead notifications.
CONTACT_NOTIFICATION_TO=

# Added in later phases. Keep server-only and empty until configured.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
# Must support JSON Schema structured outputs. Review quality/cost/privacy before production changes.
OPENROUTER_MODEL=google/gemini-2.5-flash

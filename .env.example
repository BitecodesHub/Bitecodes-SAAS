# Copy this file to .env.local and provide newly rotated credentials.
# Never paste production values into chat, source control, logs, or client code.
#
# Only the variables under "Required" are needed for the public marketing site
# to run. Everything below that is optional: each feature checks for its own
# configuration and degrades cleanly when it is absent, so a partly-configured
# deployment stays up rather than failing to boot.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB Atlas. Remember to add your deployment's egress IPs to the cluster's
# IP access list — Atlas rejects unlisted addresses with a TLS handshake error
# that looks like a certificate problem.
MONGODB_URI=
MONGODB_DB_NAME=bitecodes

# SMTP (port 465 normally uses SMTP_SECURE=true; port 587 normally uses false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Bitecodes <no-reply@bitecodes.com>"

# Comma-separated recipients for new lead notifications.
CONTACT_NOTIFICATION_TO=

# ---------------------------------------------------------------------------
# Admin panel and signed links
# ---------------------------------------------------------------------------

# Signs admin sessions, unsubscribe links, prospect report links, portal magic
# links, and email tracking tokens. At least 32 characters.
#   openssl rand -base64 32
# Rotating it invalidates every outstanding signed link and session.
AUTH_SECRET=

# Absolute origin used in links inside outbound email. Without it, emails sent
# from a preview deployment will link back to production.
SITE_URL=https://bitecodes.com

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------

# Bearer token required by POST/GET /api/cron/run. At least 16 characters.
# Without it the job runner refuses to run at all rather than running open:
# an unauthenticated runner lets anyone drain the queue and force outbound mail.
#   openssl rand -hex 16
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI (any OpenAI-compatible provider)
# ---------------------------------------------------------------------------

# Base URL of an OpenAI-compatible API, up to and including /v1.
# Examples: https://openrouter.ai/api/v1, https://integrate.api.nvidia.com/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Must support JSON Schema structured outputs. Review quality/cost/privacy
# before production changes.
AI_MODEL=google/gemini-2.5-flash
# Per-request ceiling in milliseconds (capped at 300000). Shared community
# endpoints such as integrate.api.nvidia.com can queue requests for minutes;
# raise this accordingly there.
AI_TIMEOUT_MS=25000

# Legacy names — still honoured as fallbacks when the AI_* pair is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Outbound prospecting
# ---------------------------------------------------------------------------

# Business discovery uses OpenStreetMap by default: no key, and its ODbL licence
# permits storing results with attribution. Both endpoints are shared community
# resources — the client throttles and caches, so please do not remove those
# limits. Self-host or use a commercial mirror for heavy use.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org

# Optional alternative provider. Note that Google's Places terms restrict
# caching results beyond place_id and prohibit building a prospect database from
# them, which is what this feature does. Left unset, and OpenStreetMap used, for
# that reason. Set it only if you have accepted those terms yourself.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Cold outreach
# ---------------------------------------------------------------------------

# Sender identity for cold outreach, kept separate from transactional mail so a
# campaign complaint cannot damage delivery of enquiry acknowledgements.
# Ideally a subdomain with its own SPF/DKIM/DMARC records.
OUTREACH_FROM=
OUTREACH_REPLY_TO=

# A physical postal address is legally required in commercial email (CAN-SPAM
# and equivalents). The send pipeline refuses to send outreach without one — set
# it here or in the admin Settings page.
OUTREACH_POSTAL_ADDRESS=

# Optional IMAP polling, so an outreach sequence stops automatically when the
# recipient replies. SMTP can only send; without IMAP, replies must be marked by
# hand in the admin panel.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------

# IndexNow key for notifying Bing/Yandex when content is published. Must be
# 8-128 characters of [a-zA-Z0-9-], and is served at /<key>.txt for verification.
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Reserved
# ---------------------------------------------------------------------------

# Not yet wired up. Reserved for client-portal social sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
